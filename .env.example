# Скопируйте в .env и заполните

# true — демо без Yandex (фейковый транскрипт и оценка)
MOCK_AI=true

# Yandex Cloud (нужно при MOCK_AI=false)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt

DATABASE_URL=sqlite:///./data/speechai.db
AUDIO_DIR=./data/audio
MAX_AUDIO_DURATION_MINUTES=90
# true — при старте заново обрабатывать записи со статусом uploaded/processing
RECOVER_PENDING_ON_STARTUP=false
# Memory and CPU limits for the separate sequential processing worker
WORKER_MEMORY_LIMIT=384m
WORKER_CPU_LIMIT=0.75
SESSION_SECRET=speechai-mvp-secret

# Remote audio storage over WireGuard + SSH/rsync
REMOTE_AUDIO_ENABLED=false
REMOTE_AUDIO_HOST=10.77.0.2
REMOTE_AUDIO_PORT=22
REMOTE_AUDIO_USER=speechai-storage
REMOTE_AUDIO_BASE_DIR=/srv/speechai/audio
REMOTE_AUDIO_SSH_KEY=
REMOTE_AUDIO_DELETE_LOCAL_AFTER_UPLOAD=false

# Docker / GHCR
GITHUB_OWNER=your-github-user
