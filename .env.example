# Скопируйте в .env и заполните

# true — демо без Yandex (фейковый транскрипт и оценка)
MOCK_AI=true

# Yandex Cloud (нужно при MOCK_AI=false)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt

DATABASE_URL=sqlite:///./data/speechai.db
AUDIO_DIR=./data/audio
MAX_AUDIO_DURATION_MINUTES=120
MAX_AUDIO_UPLOAD_MB=300
# Private bucket and static service-account key; never grant public read access
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
SPEECHKIT_POLL_SECONDS=60
SPEECHKIT_MAX_HOURS=24
PROCESSING_LEASE_SECONDS=600
AUTO_RETRY_MAX_HOURS=24
# true — при старте заново обрабатывать записи со статусом uploaded/processing
RECOVER_PENDING_ON_STARTUP=true
# Memory and CPU limits for the separate sequential processing worker
WORKER_MEMORY_LIMIT=384m
WORKER_CPU_LIMIT=0.75
# For a new installation only. On an existing installation, preserve its current value:
# changing it invalidates password hashes, cookies and legacy signed links.
SESSION_SECRET=speechai-mvp-secret

# Remote audio storage over WireGuard + SSH/rsync
REMOTE_AUDIO_ENABLED=false
# Keep false until WireGuard and remote checksum verification are tested
REMOTE_AUDIO_AUTO_EXPORT=false
REMOTE_AUDIO_HOST=10.77.0.2
REMOTE_AUDIO_PORT=22
REMOTE_AUDIO_USER=speechai-storage
REMOTE_AUDIO_BASE_DIR=/srv/speechai/audio
REMOTE_AUDIO_SSH_KEY=
REMOTE_AUDIO_DELETE_LOCAL_AFTER_UPLOAD=false
# Used only after starting the optional remote-audio Compose profile
EXPORT_WORKER_MEMORY_LIMIT=192m

# Docker / GHCR
GITHUB_OWNER=your-github-user
